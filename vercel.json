{
  "regions": ["fra1"],
  "functions": {
    "app/api/**/*.ts": {
      "maxDuration": 30,
      "memory": 512
    },
    "app/api/analytics/track/route.ts": {
      "maxDuration": 10,
      "memory": 512
    },
    "app/api/admin/stats/route.ts": {
      "maxDuration": 10,
      "memory": 512
    },
    "app/api/cron/sales-targets/tick/route.ts": {
      "maxDuration": 300,
      "memory": 1024
    },
    "app/api/admin/sales/targets/discovery-worker/route.ts": {
      "maxDuration": 120,
      "memory": 1024
    }
  },
  "crons": [
    {
      "path": "/api/cron/sales-targets/tick",
      "schedule": "*/5 * * * *"
    }
  ],
  "env": {
    "VERCEL": "1"
  }
}
