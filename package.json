{
  "name": "nexcel-ai-website",
  "version": "1.0.0",
  "private": true,
  "scripts": {
    "dev": "node -e \"const p=process.env.PORT||'3030';console.log('\\n  NEXCEL AI → http://localhost:'+p+'  (Standard 3030, überschreiben: PORT=… npm run dev)\\n');\" && next dev -p ${PORT:-3030} -H 0.0.0.0",
    "build": "next build",
    "build:analyze": "ANALYZE=true next build",
    "build:budget": "next build && node scripts/performance-budget.js",
    "start": "next start -p ${PORT:-3030}",
    "lint": "next lint",
    "typecheck": "tsc --noEmit",
    "test:sales": "tsx scripts/sales/run-tests.ts",
    "test:security": "tsx scripts/security/check-outbound-fetch.ts && tsx scripts/security/test-dns-rebinding.ts && tsx scripts/security/check-api-auth.ts",
    "test:performance": "tsx scripts/sales/benchmark.ts",
    "test:performance-db": "tsx scripts/sales/benchmark-critical-queries.ts",
    "test:performance-100k": "tsx scripts/sales/benchmark-list-100k.ts",
    "test:provider-controls": "tsx scripts/sales/test-provider-controls.ts",
    "test:coverage-scheduler": "tsx scripts/sales/test-coverage-scheduler.ts",
    "test:concurrency": "tsx scripts/sales/test-concurrency.ts",
    "test:duplicate-coverage": "tsx scripts/sales/test-duplicate-coverage.ts",
    "test:rollout": "tsx scripts/sales/test-rollout.ts",
    "test:resilience": "tsx scripts/sales/test-resilience.ts",
    "test:provider-failover": "tsx scripts/sales/test-provider-failover.ts",
    "test:golden-workflow": "tsx scripts/sales/test-golden-workflow.ts",
    "canary:providers": "tsx scripts/sales/run-provider-canary.ts",
    "test:migrations": "tsx scripts/db/test-migrations.ts",
    "test:migration-upgrades": "tsx scripts/db/test-migration-upgrades.ts",
    "test:db-suite": "npm run test:migrations && npm run test:migration-upgrades && npm run test:provider-controls && npm run test:provider-failover && npm run test:golden-workflow && npm run test:coverage-scheduler && npm run test:duplicate-coverage && npm run test:rollout && npm run test:concurrency && npm run test:resilience && npm run test:performance-db",
    "test:db-disposable": "tsx scripts/db/with-disposable-postgres.ts npm run test:db-suite",
    "verify:revenue": "npm run typecheck && npm run test:sales && npm run test:security && npm run test:performance",
    "create-admin": "node scripts/create-admin.js",
    "reset-admin-password": "node scripts/reset-admin-password.js",
    "db:generate": "prisma generate",
    "db:migrate": "prisma migrate dev",
    "db:push": "prisma db push",
    "db:studio": "prisma studio",
    "seo:routes": "tsx scripts/seo/run.ts routes",
    "seo:crossdomain": "tsx scripts/seo/run.ts crossdomain",
    "seo:duplicates": "tsx scripts/seo/run.ts duplicates",
    "seo:content": "tsx scripts/seo/run.ts content",
    "seo:quality": "tsx scripts/seo/run.ts quality",
    "seo:brand": "tsx scripts/seo/run.ts brand",
    "seo:location": "tsx scripts/seo/run.ts location",
    "seo:schema": "tsx scripts/seo/run.ts schema",
    "seo:links": "tsx scripts/seo/run.ts links",
    "seo:sitemap": "tsx scripts/seo/run.ts sitemap",
    "seo:lead-map": "tsx scripts/seo/run.ts lead-map",
    "seo:templates": "tsx scripts/seo/run.ts templates",
    "seo:case-studies": "tsx scripts/seo/run.ts case-studies",
    "seo:money-pages": "tsx scripts/seo/run.ts money-pages",
    "seo:location-pages": "tsx scripts/seo/run.ts location-pages",
    "seo:knowledge-pages": "tsx scripts/seo/run.ts knowledge-pages",
    "seo:scaling": "tsx scripts/seo/run.ts scaling",
    "seo:readiness": "tsx scripts/seo/run.ts readiness",
    "seo:audit": "tsx scripts/seo/run.ts audit",
    "seo:all": "tsx scripts/seo/run.ts all",
    "check:api-auth": "tsx scripts/security/check-api-auth.ts",
    "seo:citations": "tsx scripts/seo/citation-dossier.ts",
    "seo:internal-links": "tsx scripts/seo/count-internal-links.ts"
  },
  "dependencies": {
    "@huggingface/transformers": "^4.2.0",
    "@prisma/client": "^6.12.0",
    "@types/bcryptjs": "^2.4.6",
    "@types/better-sqlite3": "^7.6.13",
    "@types/jsonwebtoken": "^9.0.10",
    "@types/three": "^0.181.0",
    "@upstash/redis": "^1.36.0",
    "@vercel/kv": "^3.0.0",
    "bcryptjs": "^3.0.3",
    "better-sqlite3": "^12.10.0",
    "fontkit": "^2.0.4",
    "framer-motion": "^11.3.19",
    "jose": "^6.1.3",
    "jsonwebtoken": "^9.0.3",
    "next": "^14.2.35",
    "pdf-lib": "^1.17.1",
    "postgres": "^3.4.7",
    "react": "^18.3.1",
    "react-dom": "^18.3.1",
    "resend": "^6.26.0",
    "three": "^0.181.2",
    "undici": "^7.29.1",
    "zod": "^4.5.4"
  },
  "devDependencies": {
    "@next/bundle-analyzer": "^14.2.35",
    "@types/node": "^20.14.12",
    "@types/react": "^18.3.3",
    "@types/react-dom": "^18.3.0",
    "autoprefixer": "^10.4.19",
    "cheerio": "^1.2.0",
    "dotenv": "^17.2.3",
    "embedded-postgres": "^18.4.0-beta.17",
    "eslint": "^8.57.0",
    "eslint-config-next": "^14.2.35",
    "fast-glob": "^3.3.3",
    "pixelmatch": "^5.3.0",
    "pngjs": "^7.0.0",
    "postcss": "^8.5.28",
    "prisma": "^6.12.0",
    "tailwindcss": "^3.4.7",
    "tsx": "^4.22.4",
    "typescript": "^5.5.4"
  },
  "overrides": {
    "adm-zip": "^0.6.0",
    "defu": "^6.1.7",
    "fflate": "^0.8.3",
    "lodash": "^4.18.1",
    "postcss": "^8.5.28",
    "protobufjs": "^7.6.6",
    "sharp": "^0.35.4"
  }
}
